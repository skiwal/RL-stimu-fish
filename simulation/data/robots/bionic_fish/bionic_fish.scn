            </external_part>

            <external_part
                name="Tail2GuideLeft"
                type="box"
                physics="submerged"
                buoyant="true">

                <dimensions
                    xyz="0.00600000 0.02850000 0.01400000"/>

                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

                <material
                    name="$(arg material_name)"/>

                <look
                    name="BionicFishTailLook"/>

                <mass
                    value="0.002992500"/>

                <compound_transform
                    xyz="-0.02050000 -0.01575000 0.00000000"
                    rpy="0.0 0.0 0.0"/>

            </external_part>

            <external_part
                name="Tail2GuideRight"
                type="box"
                physics="submerged"
                buoyant="true">

                <dimensions
                    xyz="0.00600000 0.02850000 0.01400000"/>

                <origin
                    xyz="0.0 0.0 0.0"
