                    name="BionicFishTailLook"/>

                <mass
                    value="0.004042500"/>

                <compound_transform
                    xyz="-0.01950000 -0.02075000 0.00000000"
                    rpy="0.0 0.0 0.0"/>

            </external_part>

            <external_part
                name="Tail1GuideRight"
                type="box"
                physics="submerged"
                buoyant="true">

                <dimensions
                    xyz="0.00600000 0.03850000 0.01400000"/>

                <origin
