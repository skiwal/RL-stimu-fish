                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

                <material
                    name="$(arg material_name)"/>

                <look
                    name="BionicFishTailLook"/>

                <mass
                    value="0.001942500"/>

                <compound_transform
                    xyz="-0.01900000 -0.01075000 0.00000000"
                    rpy="0.0 0.0 0.0"/>

            </external_part>

            <external_part
                name="Tail3GuideRight"
