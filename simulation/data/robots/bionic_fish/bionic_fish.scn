<?xml version="1.0" encoding="UTF-8"?>

<scenario>


    <!-- ==========================================================
         Robot
         ========================================================== -->

    <robot
        name="$(arg robot_name)"
        fixed="$(arg robot_fixed)"
        self_collisions="false"
        algorithm="featherstone">


        <!-- ======================================================
             BODY
             ====================================================== -->

        <base_link
            name="Body"
            type="model"
            physics="submerged"
            buoyant="true">

            <physical>

                <mesh
                    filename="robots/bionic_fish/physics/body.obj"
                    scale="1.0"/>


                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

            </physical>


            <visual>

                <mesh
                    filename="robots/bionic_fish/visual/body.obj"
                    scale="1.0"/>


                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

            </visual>


            <material
                name="$(arg material_name)"/>


            <look
                name="BionicFishBodyLook"/>

        </base_link>


                <!-- ======================================================
             M1 MOTOR SHAFT

             Real Stonefish rigid link.

             The crank arms themselves are NOT rigid-body links.
             Their tendon attachment points are defined virtually
             in tendon_tail_actuator.cpp.
             ====================================================== -->

        <link
            name="MotorShaft"
            type="box"
            physics="surface">

            <dimensions
                xyz="0.015 0.120 0.015"/>

            <origin
                xyz="0.0 0.0 0.0"
                rpy="0.0 0.0 0.0"/>

            <material
                name="$(arg material_name)"/>

            <look
                name="BionicFishBodyLook"/>

            <mass
                value="0.005"/>

        </link>



        <!-- ======================================================
             TAIL 0
             ====================================================== -->

        <!-- ======================================================
             TAIL0 - FISHSIM-STYLE COMPOUND TAIL

             Local origin = proximal revolute joint.

             Replaces the previous full-volume fish-shaped
             physics mesh with:

                 thin spine
                    +
                 15 mm support
                    +
                 tendon guide arms
                    +
                 thin spine

             Joint positions and tendon guide coordinates
             remain unchanged.
             ====================================================== -->

        <link
            name="Tail0"
            type="compound"
            physics="submerged">


            <external_part
                name="Tail0ProxSpine"
                type="box"
                physics="submerged"
                buoyant="true">

                <dimensions
                    xyz="0.00700000 0.00100000 0.07500000"/>

                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

                <material
                    name="$(arg material_name)"/>

                <look
                    name="BionicFishTailLook"/>

                <mass
                    value="0.001000000"/>

                <compound_transform
                    xyz="-0.00350000 0.00000000 0.00000000"
                    rpy="0.0 0.0 0.0"/>

            </external_part>

            <external_part
                name="Tail0Support"
                type="box"
                physics="submerged"
                buoyant="true">

                <dimensions
                    xyz="0.01500000 0.00300000 0.10000000"/>

                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

                <material
                    name="$(arg material_name)"/>

                <look
                    name="BionicFishTailLook"/>

                <mass
                    value="0.005625000"/>

                <compound_transform
                    xyz="-0.01450000 0.00000000 0.00000000"
                    rpy="0.0 0.0 0.0"/>

            </external_part>

            <external_part
                name="Tail0GuideLeft"
                type="box"
                physics="submerged"
                buoyant="true">

                <dimensions
                    xyz="0.00600000 0.04850000 0.01400000"/>

                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

                <material
                    name="$(arg material_name)"/>

                <look
                    name="BionicFishTailLook"/>

                <mass
                    value="0.005092500"/>

                <compound_transform
                    xyz="-0.01900000 -0.02575000 0.00000000"
                    rpy="0.0 0.0 0.0"/>

            </external_part>

            <external_part
                name="Tail0GuideRight"
                type="box"
                physics="submerged"
                buoyant="true">

                <dimensions
                    xyz="0.00600000 0.04850000 0.01400000"/>

                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

                <material
                    name="$(arg material_name)"/>

                <look
                    name="BionicFishTailLook"/>

                <mass
                    value="0.005092500"/>

                <compound_transform
                    xyz="-0.01900000 0.02575000 0.00000000"
                    rpy="0.0 0.0 0.0"/>

            </external_part>

            <external_part
                name="Tail0DistSpine"
                type="box"
                physics="submerged"
                buoyant="true">

                <dimensions
                    xyz="0.00750000 0.00100000 0.07000000"/>

                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0"/>

                <material
                    name="$(arg material_name)"/>

                <look
                    name="BionicFishTailLook"/>

                <mass
                    value="0.001000000"/>

                <compound_transform
                    xyz="-0.02575000 0.00000000 0.00000000"
                    rpy="0.0 0.0 0.0"/>

            </external_part>

        </link>


        <!-- ======================================================
             TAIL 1
             ====================================================== -->

