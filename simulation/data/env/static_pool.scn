<?xml version="1.0" encoding="UTF-8"?>

<scenario>

    <!--
        ============================================================
        Bionic Fish V1 - Static Pool Test Bench
        ============================================================

        NED：

            X = 水池长度
            Y = 水池宽度
            Z = 向下

        Pool:

            X = -6 ~ +6 m
            Y = -3 ~ +3 m
            Z =  0 ~  4 m

        水面：
            Z = 0

        池底：
            Z = 4

        当前测试环境故意：
            无 current
            无 wave
            无 obstacle

        Stage 1 目标：

            只验证真实 BionicFish 的：
            - visual mesh
            - multi-link assembly
            - fish orientation
            - camera tracking
            - sensor/actuator XML creation

        Stage 1 不验证：
            - swimming
            - buoyancy dynamics
            - passive tail spring
            - motor control
    -->


    <!-- ==========================================================
         Environment
         ========================================================== -->

    <environment>
        <ned
            latitude="0.0"
            longitude="0.0"/>


        <ocean>

            <water
                density="997.0"
                jerlov="0.05"
                temperature="20.0"/>

            <waves
                height="0.0"/>

            <particles
                enabled="false"/>

            <!--
                故意没有 current。
            -->

        </ocean>

    </environment>


    <!-- ==========================================================
         Materials
         ========================================================== -->

    <materials>


        <!-- 水池 -->

        <material
            name="PoolConcrete"
            density="2400.0"
            restitution="0.20"/>


        <!--
            Stage 1:
            鱼被 fixed=true 固定，因此这个密度当前不会驱动鱼体运动。

            仍保持和水一致的 997 kg/m^3，
            为后续 Stage 2 自由浮力测试提供干净基线。
        -->
        <material
            name="FishNeutral"
            density="997.0"
            restitution="0.10"/>


        <friction_table>


            <friction
                material1="PoolConcrete"
                material2="PoolConcrete"
                static="0.80"
                dynamic="0.60"/>


            <friction
                material1="FishNeutral"
                material2="PoolConcrete"
                static="0.30"
                dynamic="0.20"/>

            <friction
                material1="FishNeutral"
                material2="FishNeutral"
                static="0.20"
                dynamic="0.10"/>


        </friction_table>

    </materials>


    <!-- ==========================================================
         Looks
         ========================================================== -->

<looks>

    <!-- ======================================================
         Pool
         ====================================================== -->

    <look
        name="PoolBottomLook"
        rgb="0.25 0.45 0.55"
        roughness="0.85"
        metalness="0.0"/>

    <look
        name="PoolWallLook"
        rgb="0.65 0.75 0.78"
        roughness="0.75"
        metalness="0.0"/>


    <!-- ======================================================
         BionicFish Stage-1 debug colors
         ====================================================== -->

    <look
        name="BionicFishBodyLook"
        rgb="0.95 0.35 0.08"
        roughness="0.40"
        metalness="0.00"/>

    <look
        name="BionicFishTailLook"
        rgb="0.85 0.12 0.08"
        roughness="0.40"
        metalness="0.00"/>

    <look
        name="BionicFishFinLook"
        rgb="0.95 0.70 0.15"
        roughness="0.40"
        metalness="0.00"/>

    <look
        name="BionicFishLeftPectoralLook"
        rgb="0.10 0.80 0.30"
        roughness="0.40"
        metalness="0.00"/>

    <look
        name="BionicFishRightPectoralLook"
        rgb="0.10 0.45 0.95"
        roughness="0.40"
        metalness="0.00"/>

</looks>



    <!-- ==========================================================
         Pool Bottom
         ========================================================== -->

    <static
        name="PoolBottom"
        type="box">

        <dimensions
            xyz="12.6 6.6 0.30"/>

        <material
            name="PoolConcrete"/>

        <look
            name="PoolBottomLook"/>

        <world_transform
            xyz="0.0 0.0 4.15"
            rpy="0.0 0.0 0.0"/>

    </static>


    <!-- ==========================================================
         Side Walls
         ========================================================== -->

    <static
        name="PoolWallPositiveY"
        type="box">

        <dimensions
            xyz="12.6 0.30 4.0"/>

        <material
            name="PoolConcrete"/>

        <look
            name="PoolWallLook"/>

        <world_transform
            xyz="0.0 3.15 2.0"
            rpy="0.0 0.0 0.0"/>

    </static>


    <static
        name="PoolWallNegativeY"
        type="box">

        <dimensions
            xyz="12.6 0.30 4.0"/>

        <material
            name="PoolConcrete"/>

        <look
            name="PoolWallLook"/>

        <world_transform
            xyz="0.0 -3.15 2.0"
            rpy="0.0 0.0 0.0"/>

    </static>


    <!-- ==========================================================
         End Walls
         ========================================================== -->

    <static
        name="PoolWallPositiveX"
        type="box">

        <dimensions
            xyz="0.30 6.0 4.0"/>

        <material
            name="PoolConcrete"/>

        <look
            name="PoolWallLook"/>

        <world_transform
            xyz="6.15 0.0 2.0"
            rpy="0.0 0.0 0.0"/>

    </static>


    <static
        name="PoolWallNegativeX"
        type="box">

        <dimensions
            xyz="0.30 6.0 4.0"/>

        <material
            name="PoolConcrete"/>

        <look
            name="PoolWallLook"/>

        <world_transform
            xyz="-6.15 0.0 2.0"
            rpy="0.0 0.0 0.0"/>

    </static>


    <!-- ==========================================================
         Real BionicFish V1

         Stage 1:
           - fixed robot
           - controller disabled in StaticPoolSimulator
           - no passive spring test
           - geometry / rendering only
         ========================================================== -->

    <include
        file="robots/bionic_fish/bionic_fish.scn">

        <arg
            name="robot_name"
            value="BionicFish"/>

        <arg
            name="material_name"
            value="FishNeutral"/>

        <arg
            name="robot_position"
            value="-3.5 0.0 2.0"/>

        <arg
            name="robot_rpy"
            value="0.0 0.0 0.0"/>

        <arg
            name="robot_fixed"
            value="false"/>

    </include>


</scenario>
