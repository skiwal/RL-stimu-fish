<?xml version="1.0" encoding="UTF-8"?>

<scenario>

    <!--
        ============================================================
        BionicFish V1
        Static Pool
        Stage 4A Fixed-Base M1 Bench Test
        ============================================================

        Coordinate convention:

            +X = pool length / fish forward
            +Y = fish right
            +Z = down

        Pool:

            approximately 12 m x 6 m x 4 m

        Water:

            density = 997 kg/m^3

        Current:

            none

        Waves:

            none


        IMPORTANT FOR STAGE 4A:

            robot_fixed = true

        This means the BionicFish base is anchored in world space.

        Internal articulated joints remain available for actuator
        testing.

        Therefore M1 can move TailJoint0 while the Body itself
        cannot accelerate or fly away.
    -->


    <!-- ==========================================================
         Environment
         ========================================================== -->

    <environment>

        <ned
            latitude="0.0"
            longitude="0.0"/>


        <ocean>

            <water
                density="997.0"
                jerlov="0.05"
                temperature="20.0"/>


            <waves
                height="0.0"/>


            <particles
                enabled="false"/>

        </ocean>

    </environment>


    <!-- ==========================================================
         Physical materials
         ========================================================== -->

    <materials>

        <material
            name="PoolConcrete"
            density="2400.0"
            restitution="0.20"/>


        <material
            name="FishNeutral"
            density="997.0"
            restitution="0.10"/>


        <friction_table>

            <friction
                material1="PoolConcrete"
                material2="PoolConcrete"
                static="0.80"
                dynamic="0.60"/>


            <friction
                material1="FishNeutral"
                material2="PoolConcrete"
                static="0.30"
                dynamic="0.20"/>


            <friction
                material1="FishNeutral"
                material2="FishNeutral"
                static="0.20"
                dynamic="0.10"/>

        </friction_table>

    </materials>


    <!-- ==========================================================
         Looks

         Fish looks are defined in the ROOT scenario for maximum
         compatibility with the local Stonefish parser.
         ========================================================== -->

    <looks>

        <!-- Pool -->

        <look
            name="PoolBottomLook"
            rgb="0.25 0.45 0.55"
            roughness="0.85"
            metalness="0.0"/>


        <look
            name="PoolWallLook"
            rgb="0.65 0.75 0.78"
            roughness="0.75"
            metalness="0.0"/>


        <!-- BionicFish debug colors -->

        <look
            name="BionicFishBodyLook"
            rgb="0.95 0.35 0.08"
            roughness="0.40"
            metalness="0.00"/>


        <look
            name="BionicFishTailLook"
            rgb="0.85 0.12 0.08"
            roughness="0.40"
            metalness="0.00"/>


        <look
            name="BionicFishFinLook"
            rgb="0.95 0.70 0.15"
            roughness="0.40"
            metalness="0.00"/>


        <look
            name="BionicFishLeftPectoralLook"
            rgb="0.10 0.80 0.30"
            roughness="0.40"
            metalness="0.00"/>


        <look
            name="BionicFishRightPectoralLook"
            rgb="0.10 0.45 0.95"
            roughness="0.40"
            metalness="0.00"/>

    </looks>


    <!-- ==========================================================
         Pool bottom
         ========================================================== -->

    <static
        name="PoolBottom"
        type="box">

        <dimensions
            xyz="12.6 6.6 0.30"/>


        <material
            name="PoolConcrete"/>


        <look
            name="PoolBottomLook"/>


        <world_transform
            xyz="0.0 0.0 4.15"
            rpy="0.0 0.0 0.0"/>

    </static>


    <!-- ==========================================================
         +Y wall
         ========================================================== -->

    <static
        name="PoolWallPositiveY"
        type="box">

        <dimensions
            xyz="12.6 0.30 4.0"/>


        <material
            name="PoolConcrete"/>


        <look
            name="PoolWallLook"/>


        <world_transform
            xyz="0.0 3.15 2.0"
            rpy="0.0 0.0 0.0"/>

    </static>


    <!-- ==========================================================
         -Y wall
         ========================================================== -->

    <static
        name="PoolWallNegativeY"
        type="box">

        <dimensions
            xyz="12.6 0.30 4.0"/>


        <material
            name="PoolConcrete"/>


        <look
            name="PoolWallLook"/>


        <world_transform
            xyz="0.0 -3.15 2.0"
            rpy="0.0 0.0 0.0"/>

    </static>


    <!-- ==========================================================
         +X wall
         ========================================================== -->

    <static
        name="PoolWallPositiveX"
        type="box">

        <dimensions
            xyz="0.30 6.0 4.0"/>


        <material
            name="PoolConcrete"/>


        <look
            name="PoolWallLook"/>


        <world_transform
            xyz="6.15 0.0 2.0"
            rpy="0.0 0.0 0.0"/>

    </static>


    <!-- ==========================================================
         -X wall
         ========================================================== -->

    <static
        name="PoolWallNegativeX"
        type="box">

        <dimensions
            xyz="0.30 6.0 4.0"/>


        <material
            name="PoolConcrete"/>


        <look
            name="PoolWallLook"/>


        <world_transform
            xyz="-6.15 0.0 2.0"
            rpy="0.0 0.0 0.0"/>

    </static>


    <!-- ==========================================================
         BionicFish V1

         STAGE 4A:
             FIXED BASE
         ========================================================== -->

    <include
        file="robots/bionic_fish/bionic_fish.scn">

        <arg
            name="robot_name"
            value="BionicFish"/>


        <arg
            name="material_name"
            value="FishNeutral"/>


        <arg
            name="robot_position"
            value="-3.5 0.0 2.0"/>


        <arg
            name="robot_rpy"
            value="0.0 0.0 0.0"/>


        <!--
            IMPORTANT:

            Stage 4A actuator bench test.
        -->
        <arg
            name="robot_fixed"
            value="true"/>

    </include>


</scenario>
