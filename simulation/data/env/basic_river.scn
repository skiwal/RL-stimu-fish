<?xml version="1.0" encoding="UTF-8"?>

<scenario>

    <!--
        ============================================================
        坐标系：NED
        ============================================================

        +X：上游
        -X：下游

        +Y/-Y：河流宽度方向

        +Z：向下


        水面：

            Z = 0 m

        河床：

            Z = 4 m

        河宽：

            8 m


        河床、河岸和障碍物都由 C++ 创建，
        因为它们需要随无限河道进行循环复用。
    -->


    <!-- ==========================================================
         Environment
         ========================================================== -->

    <environment>

        <ned
            latitude="0.0"
            longitude="0.0"/>


        <ocean>

            <water
                density="997.0"
                jerlov="0.08"
                temperature="20.0"/>


            <!--
                当前机器启用 waves > 0 时曾经出现 SIGSEGV，
                因此暂时保持平水面。
            -->
            <waves
                height="0.0"/>


            <particles
                enabled="false"/>


            <!--
                河水：

                -X = 下游

                注意：
                C++ 中必须调用 Ocean::EnableCurrents()。
            -->
            <current
                type="uniform">

                <velocity
                    xyz="-1.0 0.0 0.0"/>

            </current>

        </ocean>

    </environment>


    <!-- ==========================================================
         Materials
         ========================================================== -->

    <materials>

        <!--
            河床、河岸、固定石头。
        -->
        <material
            name="RiverRock"
            density="2600.0"
            restitution="0.15"/>


        <!--
            主鱼和移动障碍鱼。

            FishProxy 密度接近淡水，
            因而接近中性浮力。
        -->
        <material
            name="FishMaterial"
            density="997.0"
            restitution="0.20"/>


        <friction_table>

            <friction
                material1="RiverRock"
                material2="RiverRock"
                static="0.90"
                dynamic="0.70"/>


            <friction
                material1="FishMaterial"
                material2="RiverRock"
                static="0.45"
                dynamic="0.30"/>


            <friction
                material1="FishMaterial"
                material2="FishMaterial"
                static="0.30"
                dynamic="0.20"/>

        </friction_table>

    </materials>


    <!-- ==========================================================
         Looks
         ========================================================== -->

    <looks>

        <!-- 河床 -->
        <look
            name="RiverBedLook"
            rgb="0.32 0.24 0.16"
            roughness="0.95"
            metalness="0.0"/>


        <!-- 河岸 -->
        <look
            name="RiverBankLook"
            rgb="0.28 0.38 0.20"
            roughness="0.95"
            metalness="0.0"/>


        <!-- 主鱼 -->
        <look
            name="FishLook"
            rgb="0.95 0.30 0.08"
            roughness="0.40"
            metalness="0.0"/>


        <!--
            固定障碍物。

            比河床颜色稍深，
            方便视觉识别。
        -->
        <look
            name="ObstacleRockLook"
            rgb="0.18 0.16 0.14"
            roughness="0.95"
            metalness="0.0"/>


        <!--
            其他鱼先使用蓝色。

            后面可以直接换成真正的 fish mesh，
            RiverChunkManager 架构不用变化。
        -->
        <look
            name="ObstacleFishLook"
            rgb="0.08 0.45 0.80"
            roughness="0.45"
            metalness="0.0"/>

    </looks>


    <!-- ==========================================================
         Main Fish
         ========================================================== -->

    <!--
        临时主鱼。

        后续真正仿生鱼替换它时：

            方案 A：
                保持实体名 FishProxy

            方案 B：
                修改 RLFishSimulator 中寻找的名称
    -->

    <dynamic
        name="FishProxy"
        type="sphere"
        physics="submerged"
        buoyant="true">


        <dimensions
            radius="0.30"/>


        <origin
            xyz="0.0 0.0 0.0"
            rpy="0.0 0.0 0.0"/>


        <material
            name="FishMaterial"/>


        <look
            name="FishLook"/>


        <!--
            河中央，
            水下 2 m。
        -->
        <world_transform
            xyz="0.0 0.0 2.0"
            rpy="0.0 0.0 0.0"/>

    </dynamic>


</scenario>
